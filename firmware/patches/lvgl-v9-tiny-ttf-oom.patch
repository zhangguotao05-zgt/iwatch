+    if(dsc->glyph_cache) lv_cache_destroy(dsc->glyph_cache, NULL);
+    if(dsc->draw_data_cache) lv_cache_destroy(dsc->draw_data_cache, NULL);
+    if(dsc->kerning_cache) lv_cache_destroy(dsc->kerning_cache, NULL);
+    lv_free(dsc);
+}
+
+static void tiny_ttf_report_oom(ttf_font_desc_t * dsc, lv_tiny_ttf_oom_reason_t reason)
+{
+    if(dsc != NULL) {
+        if(dsc->oom_latched) return;
+        dsc->oom_latched = true;
+    }
+    if(oom_cb) oom_cb(reason, oom_cb_user_data);
+}
+
+static void * tiny_ttf_stb_malloc(size_t size, void * user_data)
+{
+    void * memory = lv_malloc(size);
+    if(memory == NULL && user_data != NULL) {
+        ((ttf_font_desc_t *)user_data)->stb_oom = true;
+    }
+    return memory;
+}
