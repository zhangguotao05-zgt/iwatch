     return obj;
 }
 
+/* 受控构造：全部申请成功后才提交屏幕表或父子关系，失败保留原表。 */
+lv_obj_t * lv_obj_class_create_obj_checked(const lv_obj_class_t * class_p, lv_obj_t * parent)
+{
+    if(!class_p) return NULL;
+    if(parent) LV_ASSERT_OBJ(parent, MY_CLASS);
+    uint32_t size = get_instance_size(class_p);
+    if(size < sizeof(lv_obj_t)) return NULL;
+    lv_obj_t * obj = lv_malloc_zeroed(size);
+    if(!obj) return NULL;
+    if(!parent) {
+        lv_display_t * disp = lv_display_get_default();
+        if(!disp || disp->screen_cnt == UINT32_MAX / sizeof(lv_obj_t *)) { lv_free(obj); return NULL; }
+        lv_obj_t ** screens = lv_realloc(disp->screens, sizeof(*screens) * (disp->screen_cnt + 1));
+        if(!screens) { lv_free(obj); return NULL; }
+        obj->class_p = class_p;
+        obj->coords.x2 = lv_display_get_horizontal_resolution(disp) - 1;
+        obj->coords.y2 = lv_display_get_vertical_resolution(disp) - 1;
+        disp->screens = screens;
+        disp->screens[disp->screen_cnt++] = obj;
+        return obj;
+    }
+    lv_obj_spec_attr_t * attr = parent->spec_attr;
+    if(!attr) {
+        attr = lv_malloc_zeroed(sizeof(*attr));
+        if(!attr) { lv_free(obj); return NULL; }
+        attr->scroll_dir = LV_DIR_ALL;
+        attr->scrollbar_mode = LV_SCROLLBAR_MODE_AUTO;
+    }
+    if(attr->child_cnt == UINT16_MAX) {
+        if(!parent->spec_attr) lv_free(attr);
+        lv_free(obj);
+        return NULL;
+    }
+    lv_obj_t ** children = lv_realloc(attr->children, sizeof(*children) * (attr->child_cnt + 1));
+    if(!children) {
+        if(!parent->spec_attr) lv_free(attr);
+        lv_free(obj);
+        return NULL;
+    }
+    obj->class_p = class_p;
+    obj->parent = parent;
+    attr->children = children;
+    attr->children[attr->child_cnt++] = obj;
+    parent->spec_attr = attr;
+    return obj;
+}
+
