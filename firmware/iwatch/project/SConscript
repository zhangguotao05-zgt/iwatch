import os
from building import *

cwd = GetCurrentDir()
objs = []
list = os.listdir(cwd)

# Add SDK
Import('SIFLI_SDK')
sdk_objs = SConscript(os.path.join(SIFLI_SDK, 'SConscript'), variant_dir="sifli_sdk", duplicate=0)

# 项目固定了触摸线程栈预算，因此用仓库内的同版本驱动副本替换 SDK 原文件。
vendor_touch = os.path.normcase(os.path.abspath(os.path.join(
    SIFLI_SDK, 'rtos/rtthread/bsp/sifli/drivers/drv_touch.c')))

def source_path(node):
    try:
        return os.path.normcase(os.path.abspath(node.rfile().abspath))
    except AttributeError:
        return os.path.normcase(os.path.abspath(str(node)))

def remove_vendor_touch(items):
    kept = []
    removed = 0
    for item in items:
        if type(item) == type([]):
            nested, nested_removed = remove_vendor_touch(item)
            kept.append(nested)
            removed += nested_removed
        elif source_path(item) == vendor_touch:
            removed += 1
        else:
            kept.append(item)
    return kept, removed

sdk_objs, removed_objects = remove_vendor_touch(sdk_objs)
removed_groups = 0
for project_group in Projects:
    old_sources = project_group.get('src', [])[:]
    new_sources, count = remove_vendor_touch(old_sources)
    if count:
        project_group['src'] = new_sources
        removed_groups += count
if removed_objects != 1 or removed_groups != 1:
    raise RuntimeError('未能唯一替换 SDK drv_touch.c，拒绝生成含重复触摸驱动的镜像。')
objs.extend(sdk_objs)

# Add application source code
# workaround: src folder must be created before resource/strings folder is used, otherwise langpack would not be built
Execute(Mkdir('src'))
objs.extend(SConscript(cwd+'/../src/SConscript', variant_dir="src", duplicate=0))

Return('objs')
