["TEXT","e353",150,460,0,"J101 is for a true 1.8 V debugger/UART adapter. VTREF is a reference output, not an input supply.","small",0]
["TEXT","e354",150,436,0,"RESET_N must be pulled up to PVDD1 (+1V8). BOOT_MODE belongs to VIOA (+3V3).","small",0]
["TEXT","e355",150,412,0,"BOOT low = normal boot, high at reset = download. HOME/PB54 is on DISPLAY AND CONTROLS.","small",0]
["TEXT","e356",150,388,0,"Start with external crystal trim capacitors unpopulated for the selected CL values, then measure/calibrate.","small",0]
["TEXT","e357",150,364,0,"HCPU target up to 240 MHz; first bring-up uses conservative clock and Flash timing.","small",0]
["TEXT","e358",150,340,0,"Budget: 32 MB SiP PSRAM total, 1 MB SiP NOR, plus the external 16 MB NOR on the next sheet.","small",0]
