["TEXT","e149",140,420,0,"U1 parts on every sheet are units of ONE physical BGA256 IC, with a shared unique ID and a single BOM entry.","small",0]
["TEXT","e150",140,396,0,"NC text marks deliberate unused pins. Configure unused digital inputs to avoid floating input current.","small",0]
["TEXT","e151",140,372,0,"Ball names come from the official SiFli PADS symbol; full alternate-function names are in chip-ball-audit.csv.","small",0]
["TEXT","e152",140,348,0,"Only actual device I/O is shown here. No module castellated-pad numbers remain in this project.","small",0]
