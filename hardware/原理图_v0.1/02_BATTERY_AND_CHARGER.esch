["TEXT","e386",120,450,0,"Battery: protected 1S Li-ion/LiPo, 4.2 V charge rating; nominal 3.7 V.","small",0]
["TEXT","e387",120,426,0,"400 mAh is a planning assumption. Verify max charge current and cell dimensions.","small",0]
["TEXT","e388",120,402,0,"Use a real 10k NTC in thermal contact with the cell; TS is not tied to GND.","small",0]
["TEXT","e389",120,378,0,"Connector polarity and NTC B value must be checked against the selected pack.","small",0]
["TEXT","e390",120,354,0,"USB-C is charge-only. USB data / SBU contacts are not routed in this revision.","small",0]
["TEXT","e391",1180,430,0,"I_CHG typ = 890 / 6980 = 127.5 mA (charger / resistor tolerance applies).","small",0]
["TEXT","e392",1180,406,0,"EN2=0, EN1=1: fixed 500 mA input mode; use a suitable USB 5 V supply.","small",0]
["TEXT","e393",1180,382,0,"ILIM resistor fitted as required even when fixed input mode is selected.","small",0]
["TEXT","e394",1180,358,0,"TMR and ITERM open: internal default timer / termination behavior.","small",0]
["TEXT","e395",1180,334,0,"VSYS ~ battery voltage on battery; up to 4.4 V with external input.","small",0]
["TEXT","e396",1180,310,0,"Protection IC is required in the purchased battery pack; not duplicated here.","small",0]
