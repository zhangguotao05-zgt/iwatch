["TEXT","e116",130,430,0,"U1 units A-E are the same physical SF32LB58 module. Shared designator and unique ID preserve one BOM item.","small",0]
["TEXT","e117",130,406,0,"All pads marked NC on this sheet are deliberately not routed in v0.1. This is not an omission of power pins.","small",0]
["TEXT","e118",130,382,0,"114 / 115 are shown as UNVERIFIED_UNUSED; confirm names using the module pad drawing before future reuse.","small",0]
["TEXT","e119",130,358,0,"The imported module footprint comes from the SiFli native EDA reference project.","small",0]
["TEXT","e120",130,334,0,"Other IC and mechanical footprints are unbound for deliberate review before PCB layout.","small",0]
["TEXT","e121",130,310,0,"No PCB outline, RF antenna, audio chain, network radio enablement or production release is included.","small",0]
["TEXT","e122",130,286,0,"Next gate: verify imported electrical nets, complete footprint audit, confirm panel adapter and battery pack.","small",0]
