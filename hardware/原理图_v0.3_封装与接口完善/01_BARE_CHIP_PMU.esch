["TEXT","e336",120,450,0,"L101/C101/C102: BUCK1 VSW -> inductor -> FB. L102/C103/C104: BUCK2 VSW -> inductor -> FB.","small",0]
["TEXT","e337",120,426,0,"The internal LDO nodes only take bypass capacitors. Do not connect them to +1V8 or +3V3.","small",0]
["TEXT","e338",120,402,0,"B4/B5 VDD_EXT remain open as in the official internal-PMU reference. Recheck for any external-core-supply mode.","small",0]
["TEXT","e339",120,378,0,"All 44 ground/reference-return balls are listed on the final sheet; connect to the common ground plane.","small",0]
["TEXT","e340",120,354,0,"Input power comes from the POWER RAILS sheet. Clock/reset and SiP power switching are shown on subsequent sheets.","small",0]
["TEXT","e341",120,330,0,"BGA footprint is bound; stackup, fanout, crystal layout and assembly process still require PCB review.","small",0]
["TEXT","e342",120,306,0,"U1 is a purchased packaged IC soldered directly onto the custom mainboard; there is no core module in this BOM.","small",0]
