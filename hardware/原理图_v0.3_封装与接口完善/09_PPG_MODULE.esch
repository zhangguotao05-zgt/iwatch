["TEXT","e425",115,640,0,"PD1 is integrated: pin 1 remains open. PD2 pin 25 must be joined to pin 26.","small",0]
["TEXT","e426",115,616,0,"VCORE and VREF are capacitor-only nodes; do not drive with +1V8.","small",0]
["TEXT","e427",115,592,0,"The unused accelerometer SPI pins stay unloaded in host-feed architecture.","small",0]
["TEXT","e428",115,568,0,"PPG_INT_LOCAL is the local AFE interrupt; host communication uses MFIO.","small",0]
["TEXT","e429",115,544,0,"Crystal load network follows the ADI reference; no guessed external load capacitors.","small",0]
["TEXT","e430",1140,350,0,"Host I2C / MFIO / reset all 1.8 V. I2C pull-ups are on sheet 08.","small",0]
["TEXT","e431",1140,326,0,"Hold PPG reset while required rails / clock stabilize, then follow ADI boot protocol.","small",0]
["TEXT","e432",1140,302,0,"C601 at VDD; C602+C603 at VDD_AFE; C606+C607 at VLED.","small",0]
["TEXT","e433",1140,278,0,"Common ground electrically; keep LED pulse returns away from optical/analog nodes.","small",0]
["TEXT","e434",1140,254,0,"This is a real sensing circuit; accuracy is not established by the schematic.","small",0]
